# ISL NOVA configuration. Copy to .env and fill in. Never commit .env.

# development | production (production enforces a strong JWT secret, no synthetic models, no wildcard CORS)
ISL_NOVA_ENV=development

# SQLite for development; PostgreSQL in production
DATABASE_URL=sqlite:///./storage/isl_nova.db
# DATABASE_URL=postgresql://islnova:CHANGE_ME@localhost:5432/islnova
POSTGRES_PASSWORD=CHANGE_ME

# >= 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_TTL_MINUTES=120

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8000

# Object storage (local adapter) and model registry
STORAGE_DIR=./storage/objects
MODEL_REGISTRY_DIR=./artifacts/models
MAX_UPLOAD_MB=50
ANALYSIS_RETENTION_HOURS=24

# Creates/ensures an admin account at startup (remove after first boot if you prefer)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

ALLOW_OPEN_REGISTRATION=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
PBKDF2_ITERATIONS=600000

# Server-side MediaPipe models (optional; enables video analysis + INCLUDE import)
# https://ai.google.dev/edge/mediapipe/solutions/vision/hand_landmarker
ISL_NOVA_HAND_MODEL=
ISL_NOVA_POSE_MODEL=

# Never enable outside automated tests
ALLOW_SYNTHETIC_MODEL=false
